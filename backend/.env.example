# Modo de ejecución y puerto del servidor HTTP.
NODE_ENV=development
PORT=3000

# Orígenes exactos del frontend, separados por coma y sin rutas.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Genera un secreto local; el ejemplo queda vacío deliberadamente.
# Login firma JWT con el secreto local obligatorio y duración corta validada.
JWT_SECRET=
JWT_EXPIRES_IN=15m

# SQLite local se crea al arrancar; Docker usará /data/database.sqlite.
SQLITE_PATH=./data/database.sqlite

# Solo entorno académico/local. En producción define false y ejecuta migraciones.
SQLITE_SYNCHRONIZE=true
