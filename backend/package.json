{
  "name": "soccer-dashboard-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API with TypeORM and SQLite for Soccer Dashboard",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0"
  },
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "build": "nest build",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test *.cjs *.mjs --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs",
    "test:watch": "npm test -- --watch",
    "test:cov": "npm test -- --coverage",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest-e2e.config.cjs --runInBand",
    "verify": "npm run lint && npm run format:check && npm run type-check && npm run test:cov && npm run test:e2e && npm run build",
    "migration:run": "npm run build && node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "migration:show": "npm run build && node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/typeorm/cli.js migration:show -d dist/database/data-source.js",
    "seed": "npm run build && node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/seed/main.js",
    "seed:clean": "npm run build && node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/seed/main.js --clean"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/typeorm": "^12.0.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "prettier": "3.9.5",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.0"
  }
}
