{
  "name": "soccer-dashboard-nuxt",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "type-check": "nuxt typecheck",
    "verify": "npm run lint && npm run format:check && npm run type-check && npm run build && npm test"
  },
  "dependencies": {
    "h3": "^1.15.4",
    "nuxt": "4.6.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^10.13.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.1.0"
  }
}
